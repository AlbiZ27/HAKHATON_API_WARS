
FACTUS_USERNAME="your-factus-username"
FACTUS_PASSWORD="your-factus-password"
FACTUS_CLIENT_ID="your-factus-client-id"
FACTUS_CLIENT_SECRET="your-factus-client-secret"
FACTUS_BASE_URL="https://api-sandbox.factus.com.co"

FACTUS_NUMBERING_RANGE_ID="389"
FACTUS_DEFAULT_TAX_RATE="19.00"
FACTUS_DEFAULT_UNIT_MEASURE_CODE="94"
FACTUS_DEFAULT_PAYMENT_FORM="1"
FACTUS_DEFAULT_PAYMENT_METHOD_CODE="10"


# Where LocalAuth stores the WhatsApp session.
# Local: ./.wwebjs_auth
# Railway: point this at a mounted Volume so the session survives
#          redeploys and you don't rescan the QR, e.g. /data/.wwebjs_auth
WHATSAPP_SESSION_PATH="./.wwebjs_auth"
WHATSAPP_CLIENT_ID="factus-bot"
# Delay (ms) before reconnecting after a disconnect. Prevents a tight reconnect
# loop that would spawn Chromium faster than it can be torn down.
WHATSAPP_RECONNECT_DELAY_MS="5000"
# Path to the Chrome/Chromium binary Puppeteer should launch.
# Local (Debian/Ubuntu): /usr/bin/google-chrome-stable
# Docker (puppeteer image): /usr/bin/google-chrome-stable (already bundled)
PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome-stable"

# Local only. On Railway, PORT is injected by the platform; do not set it.
PORT="3000"

# Public base URL used to build invoice PDF download links.
# Local: http://localhost:3000
# Railway: the service's public domain, e.g. https://<service>.up.railway.app
PUBLIC_BASE_URL="http://localhost:3000"
# How long a PDF download link stays valid (ms). Default: 1 hour.
PDF_LINK_TTL_MS="3600000"

# Gemini (fallback extraction for free-form messages). Optional.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TIMEOUT_MS="8000"
