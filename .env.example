# Factus API credentials (sandbox)
# Get these from your Factus account / administrator.
FACTUS_USERNAME=""
FACTUS_PASSWORD=""
FACTUS_CLIENT_ID=""
FACTUS_CLIENT_SECRET=""
FACTUS_BASE_URL="https://api-sandbox.factus.com.co"

# Factus invoice defaults (adjust to your Factus account / DIAN resolution)
FACTUS_NUMBERING_RANGE_ID=""
FACTUS_DEFAULT_TAX_RATE="19.00"
FACTUS_DEFAULT_UNIT_MEASURE_CODE="94"
FACTUS_DEFAULT_PAYMENT_FORM="1"
FACTUS_DEFAULT_PAYMENT_METHOD_CODE="10"

# WhatsApp Cloud API (Meta for Developers)
# Get ACCESS_TOKEN and PHONE_NUMBER_ID from the Meta app dashboard.
# VERIFY_TOKEN is a secret you choose; use the same value in the Meta webhook config.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="factus-bot-verify-2026"
WHATSAPP_API_VERSION="v21.0"

# Server
PORT="3000"
